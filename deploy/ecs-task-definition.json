{
  "family": "meridian-signal-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "REPLACE_WITH_IMAGE",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {"name": "DATABASE_URL", "value": "REPLACE_WITH_DATABASE_URL"},
        {"name": "REDIS_URL", "value": "REPLACE_WITH_REDIS_URL"},
        {"name": "JWT_SIGNING_KEY", "value": "REPLACE_WITH_JWT_SIGNING_KEY"}
      ]
    }
  ]
}
